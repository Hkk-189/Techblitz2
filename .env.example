# ==============================================================================
# TECH BLITZ: The Jane Protocol — Environment Variables
# ==============================================================================

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key (Server-Only secret, bypasses RLS for authoritative writes)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Anon Key (Public key for client-side Realtime connection)
SUPABASE_ANON_KEY=your-supabase-anon-key

# High-entropy secret for signing authentication JWT tokens
JWT_SECRET=tech-blitz-jane-protocol-secret-key-32-chars-minimum
